#ifndef PLATFORM_SPECIFICATION_AH
#define PLATFORM_SPECIFICATION_AH

#include "platform_io.h"
#include "Main_Model_Braking_Demo.h"
//#include "ThrottleControl.h"
#include <stdio.h>

aspect Platform_IO_Specification {

    advice execution("void Main_Model_Braking_Demo::step()") : before() {
        Main_Model_Braking_Demo *model = tjp->that();

        model->setreference_speed((uint16_t)Platform_ReadSignal(SIGNAL_REFERENCE_SPEED));
        model->setrequested_brake((uint16_t)Platform_ReadSignal(SIGNAL_REQUESTED_BRAKE));
        model->setfront_left_grip_loss((uint16_t)Platform_ReadSignal(SIGNAL_FRONT_LEFT_GRIP_LOSS));
        model->setfront_right_grip_loss((uint16_t)Platform_ReadSignal(SIGNAL_FRONT_RIGHT_GRIP_LOSS));
        model->setfront_left_wheel_speed((uint16_t)Platform_ReadSignal(SIGNAL_FRONT_LEFT_WHEEL_SPEED));
        model->setfront_right_wheel_speed((uint16_t)Platform_ReadSignal(SIGNAL_FRONT_RIGHT_WHEEL_SPEED));
    }

    advice execution("void Main_Model_Braking_Demo::step()") : after() {
        Main_Model_Braking_Demo *model = tjp->that();

        Platform_WriteSignal(SIGNAL_FRONT_LEFT_WHEEL_SLIP, (int32_t)model->getfront_left_wheel_slip());
        Platform_WriteSignal(SIGNAL_FRONT_RIGHT_WHEEL_SLIP, (int32_t)model->getfront_right_wheel_slip());
        Platform_WriteSignal(SIGNAL_FRONT_LEFT_MOTOR_COMMAND, (int32_t)model->getfront_left_motor_command());
        Platform_WriteSignal(SIGNAL_FRONT_RIGHT_MOTOR_COMMAND, (int32_t)model->getfront_right_motor_command());
        Platform_WriteSignal(SIGNAL_FRONT_LEFT_SLIP_ACTIVE, model->getfront_left_slip_active() ? 1 : 0);
        Platform_WriteSignal(SIGNAL_FRONT_RIGHT_SLIP_ACTIVE, model->getfront_right_slip_active() ? 1 : 0);
    }
};

#endif





