#ifndef PLATFORM_SPECIFICATION_AH
#define PLATFORM_SPECIFICATION_AH

#include "platform_io.h"

aspect PlatformSpecification {

	advice get("int flWheelSpeed") : around() {
        *tjp->result() = Platform_ReadSignal(SIGNAL_FL_WHEEL_SPEED);
    }
    
    advice get("int frWheelSpeed") : around() {
        *tjp->result() = Platform_ReadSignal(SIGNAL_FR_WHEEL_SPEED);
    }

};

#endif
